#!/usr/bin/env bash
# 内容引擎在"同步 Blog"成功后调用本脚本，异步重建公开站。
#
# 公开站是 next start 运行预构建产物，siteConfig.ts 这类源码改动
# 必须重新 build + 重启服务才会生效。没有这一步，控制台改了设置
# 而线上纹丝不动。
#
# 该脚本允许 xhblogs 用户通过 sudo 免密调用（见 /etc/sudoers.d/xhblogs-rebuild）。
set -uo pipefail

LOG=/var/log/xhblogs-rebuild.log
HELPER=/usr/local/bin/xhblogs-rebuild

if [ ! -x "$HELPER" ]; then
  echo "$(date '+%F %T') 未找到 $HELPER，跳过重建" >> "$LOG"
  exit 0
fi

# 已经在重建中就不再重复触发
if pgrep -f "next build" >/dev/null 2>&1 || pgrep -f "npm run build" >/dev/null 2>&1; then
  echo "$(date '+%F %T') 已有重建任务在运行，跳过本次请求" >> "$LOG"
  exit 0
fi

echo "$(date '+%F %T') 收到重建请求，开始后台构建" >> "$LOG"
nohup "$HELPER" >> "$LOG" 2>&1 &
exit 0
