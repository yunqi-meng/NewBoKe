#!/usr/bin/env bash
# 线上发布助手（服务器部署形态）
#
# 🌟 新的发布模型：数据库是唯一真相，git 存的是「内容快照」。
#
#    内容（文章、说说、相册、友链、项目、站点配置）都存在统一后端的数据库里，
#    发布 = 把当前内容导出一份快照 JSON（snapshots/）→ 提交进仓库 → 同步到线上。
#    公开站与控制台都是运行时读数据库，所以内容改动不需要重新构建，刷新即可见。
#
# 脚本依次完成：
#   1. 先与仓库最新版本合并（开发机也会推代码，不合并会被非快进拒绝）
#   2. 提交本次内容快照（snapshots/ 下的 JSON）
#   3. 推送回服务器上的裸仓库，保持源码仓库与线上同步
#   4. 推送到 GitHub 仓库（控制台按钮的最终目的地；结果写进发布状态）
#   5. 按需重建：只有代码变了才重建前端 / 重启后端，内容变了不用动
#
# 用法：xhblogs-publish [仓库路径] [publish|rollback]
#   rollback 只是换个提交信息前缀（chore(rollback)），发布历史里能一眼分清。
#
# 本脚本由统一后端通过 sudo 免密调用（授权见 /etc/sudoers.d/xhblogs-rebuild）。
set -uo pipefail

REPO="${1:-/opt/xinghui-blog}"
KIND="${2:-publish}"
BLOG_DIR="$REPO/XHBlogs"
STATUS_FILE="$REPO/.publish-status.json"
LOG="/var/log/xhblogs-publish.log"
REBUILD="/usr/local/bin/xhblogs-rebuild"
MANAGER_REBUILD="/usr/local/bin/xhblogs-manager-rebuild"
BACKEND_RESTART="systemctl restart xhblogs-manager-api.service"
APP_USER="xhblogs"
GIT_NAME="Blog CMS"
GIT_EMAIL="cms@localhost"

case "$KIND" in
  rollback) COMMIT_KIND="chore(rollback)" ;;
  *)        COMMIT_KIND="chore(publish)" ;;
esac

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

# --------------------------------------------------------------------------
# 改动路径分类
#
#   content —— 内容快照。运行时读数据库，改完刷新即可见，不用重新构建
#   site    —— 公开站代码。要重新 build + 重启 xhblogs
#   console —— 控制台代码。要重新 build + 重启 xhblogs-manager-web
#   backend —— 统一后端代码。只需重启 xhblogs-manager-api，不用重新构建
#   other   —— 与线上无关（脚本、文档等）
#
# 这段逻辑单独抽成函数，tools/test-publish-paths.sh 会直接抽出来做断言，
# 改分类规则时只改这一处，测试和真实发布不会走偏。
# --------------------------------------------------------------------------
classify_path() {
  case "$1" in
    snapshots/*)                      echo "content" ;;
    XHBlogs/*)                        echo "site" ;;
    my-blog-manager/*)                echo "console" ;;
    server/app/*|server/requirements.txt) echo "backend" ;;
    *)                               echo "other" ;;
  esac
}

# 以网站运行用户执行命令，避免 root 触发 git 的 dubious ownership 拦截
as_app_user() {
  if command -v runuser >/dev/null 2>&1; then
    runuser -u "$APP_USER" -- "$@"
  else
    su -s /bin/bash "$APP_USER" -c "$*"
  fi
}

# 写发布状态文件（JSON），内容保持简单以免需要额外转义
# 第四个参数 effective_ts：这次改动真正对外生效的时间戳。
# 纯内容发布不会重新构建，构建号的时间戳会比本次发布早，
# 控制台要靠这个字段判断「已同步到线上」。
write_status() {
  local state="$1"
  local message="$2"
  local started_ts="${3:-0}"
  local effective_ts="${4:-0}"
  local safe_message
  safe_message=$(echo "$message" | tr -d '"' | tr '\n' ' ')
  local tmp="$STATUS_FILE.tmp"
  cat > "$tmp" <<JSON
{
  "state": "$state",
  "message": "$safe_message",
  "startedAtTimestamp": $started_ts,
  "effectiveAtTimestamp": $effective_ts,
  "updatedAt": "$(date '+%F %T')"
}
JSON
  mv -f "$tmp" "$STATUS_FILE" 2>/dev/null || true
  chown "$APP_USER":"$APP_USER" "$STATUS_FILE" 2>/dev/null || true
  chmod 644 "$STATUS_FILE" 2>/dev/null || true
}

START_TS=$(date +%s)
GITHUB_STATE="none"

# --------------------------------------------------------------------------
# 并发保护：同一时刻只允许一个发布助手在跑
#
# 连点两下「发布上线」会让两个助手同时进入同一个工作区：一个推送被非快进
# 拒绝，两个 next build 同时跑，最后站点停在半新半旧的状态。
# 这里用 flock 把后来的那一次挡住，等前一次结束再继续。
# --------------------------------------------------------------------------
LOCK_FILE="/var/lock/xhblogs-publish.lock"
[ -d /var/lock ] || LOCK_FILE="/tmp/xhblogs-publish.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log "已有发布任务在运行，等待其完成"
  flock 9
fi

write_status running "正在提交内容快照并同步到线上" "$START_TS"
log "=== 收到发布请求：仓库 $REPO（$KIND） ==="

if [ ! -d "$REPO/.git" ]; then
  log "仓库不存在：$REPO"
  write_status failed "服务器工作区不是 Git 仓库" "$START_TS"
  exit 1
fi

# 记住发布前的提交点：后面用它算出这次到底改了哪些文件
BASE_COMMIT=$(as_app_user git -C "$REPO" rev-parse HEAD 2>/dev/null || echo "")
log "发布前提交：${BASE_COMMIT:-未知}"

# 已有构建在跑就不要重复触发
if pgrep -f "next build" >/dev/null 2>&1 || pgrep -f "npm run build" >/dev/null 2>&1; then
  log "已有构建任务在运行，跳过本次发布"
  write_status busy "已有构建任务在运行，本次发布请求已跳过" "$START_TS"
  exit 0
fi

# 1. 先与仓库最新版本同步
#    开发机和服务器都会往同一个分支提交（开发机推代码，服务器推控制台发布的内容），
#    服务器不先合并就提交的话，推送会被非快进拒绝，整个发布直接失败。
if as_app_user git -C "$REPO" fetch origin main >> "$LOG" 2>&1; then
  if ! as_app_user git -C "$REPO" merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
    STASHED=0
    if ! as_app_user git -C "$REPO" diff --quiet 2>/dev/null || ! as_app_user git -C "$REPO" diff --cached --quiet 2>/dev/null; then
      if as_app_user git -C "$REPO" -c user.name="$GIT_NAME" -c user.email="$GIT_EMAIL" \
          stash push -m "publish-autostash" >> "$LOG" 2>&1; then
        STASHED=1
      fi
    fi

    if as_app_user git -C "$REPO" -c user.name="$GIT_NAME" -c user.email="$GIT_EMAIL" \
        merge --no-edit origin/main >> "$LOG" 2>&1; then
      log "已合并 origin/main（服务器此前落后于仓库）"
    else
      as_app_user git -C "$REPO" merge --abort >> "$LOG" 2>&1 || true
      if [ "$STASHED" = "1" ]; then
        as_app_user git -C "$REPO" stash pop >> "$LOG" 2>&1 || true
      fi
      write_status failed "合并仓库最新版本失败，请查看 $LOG" "$START_TS"
      exit 1
    fi

    if [ "$STASHED" = "1" ]; then
      if ! as_app_user git -C "$REPO" stash pop >> "$LOG" 2>&1; then
        log "恢复控制台改动失败，改动仍保留在 stash 里"
        write_status failed "恢复控制台改动失败，请查看 $LOG" "$START_TS"
        exit 1
      fi
    fi
  fi
fi

# 2. 只把内容快照加入暂存区，避免误提交运行时文件
#    （数据库、媒体、音乐都在仓库外运行，不会出现在这里）
SNAPSHOT_DIR="$REPO/snapshots"
mkdir -p "$SNAPSHOT_DIR"
chown "$APP_USER":"$APP_USER" "$SNAPSHOT_DIR" 2>/dev/null || true

as_app_user git -C "$REPO" add -- snapshots >> "$LOG" 2>&1

if as_app_user git -C "$REPO" diff --cached --quiet; then
  log "内容快照没有变化，跳过提交"
else
  as_app_user git -C "$REPO" \
    -c user.name="$GIT_NAME" -c user.email="$GIT_EMAIL" \
    commit -m "$COMMIT_KIND: 控制台发布 $(date '+%F %T')" >> "$LOG" 2>&1
  log "提交完成：$(as_app_user git -C "$REPO" rev-parse --short HEAD)"
fi

# 3. 推送回服务器上的裸仓库，保持源码仓库与线上同步
#    推送失败时再同步一次（期间开发机可能又推了新代码），仍失败才算发布失败
PUSH_OK=0
if as_app_user git -C "$REPO" push origin HEAD:main >> "$LOG" 2>&1; then
  PUSH_OK=1
else
  log "首次推送被拒，重新同步后重试"
  as_app_user git -C "$REPO" fetch origin main >> "$LOG" 2>&1
  if as_app_user git -C "$REPO" -c user.name="$GIT_NAME" -c user.email="$GIT_EMAIL" \
      merge --no-edit --autostash origin/main >> "$LOG" 2>&1; then
    if as_app_user git -C "$REPO" push origin HEAD:main >> "$LOG" 2>&1; then
      PUSH_OK=1
    fi
  fi
fi

if [ "$PUSH_OK" != "1" ]; then
  log "推送失败"
  write_status failed "推送源码仓库失败，请查看 $LOG" "$START_TS"
  exit 1
fi

# 4. 推送到 GitHub 仓库（控制台「推送到 GitHub 仓库」按钮的最终目的地）
#    服务端仓库已经推成功，这里失败不影响内容在线，但要在状态里如实告诉控制台。
if as_app_user git -C "$REPO" remote get-url github >/dev/null 2>&1; then
  if as_app_user git -C "$REPO" push github HEAD:main >> "$LOG" 2>&1; then
    GITHUB_STATE="pushed"
    log "已推送到 GitHub 仓库"
  else
    GITHUB_STATE="failed"
    log "GitHub 推送失败（内容已在线、服务器仓库已同步）"
  fi
else
  GITHUB_STATE="none"
  log "仓库未配置 github 远端，跳过 GitHub 推送"
fi

# 5. 按需重建
#
#    只有内容变化 → 不用重建（站点运行时读数据库，内容早就在线上了）
#    代码有变化 → 公开站/控制台分别重新构建，后端重启服务
CHANGED_FILES=""
if [ -n "$BASE_COMMIT" ]; then
  CHANGED_FILES=$(as_app_user git -C "$REPO" diff --name-only "$BASE_COMMIT" HEAD 2>/dev/null || true)
fi

SITE_CODE_CHANGED=0
CONSOLE_CODE_CHANGED=0
BACKEND_CODE_CHANGED=0
if [ -n "$CHANGED_FILES" ]; then
  OLD_IFS="$IFS"
  IFS=$'\n'
  # shellcheck disable=SC2086
  for changed_path in $CHANGED_FILES; do
    [ -z "$changed_path" ] && continue
    case "$(classify_path "$changed_path")" in
      content) continue ;;                       # 内容快照不是代码，不用重新构建
      site)    SITE_CODE_CHANGED=1 ;;
      console) CONSOLE_CODE_CHANGED=1 ;;
      backend) BACKEND_CODE_CHANGED=1 ;;
      *)       ;;                                # other：与线上无关
    esac
  done
  IFS="$OLD_IFS"
fi

log "本次改动：站点代码=$SITE_CODE_CHANGED 控制台代码=$CONSOLE_CODE_CHANGED 后端代码=$BACKEND_CODE_CHANGED"

if [ "$SITE_CODE_CHANGED" = "1" ]; then
  if [ ! -x "$REBUILD" ]; then
    log "未找到重建脚本 $REBUILD"
    write_status failed "未找到重建脚本 $REBUILD" "$START_TS"
    exit 1
  fi

  write_status running "正在重新构建公开站" "$START_TS"
  log "开始重建公开站"
  if ! "$REBUILD" >> "$LOG" 2>&1; then
    log "重建失败"
    write_status failed "构建失败，请查看 $LOG" "$START_TS"
    exit 1
  fi
fi

if [ "$CONSOLE_CODE_CHANGED" = "1" ]; then
  if [ -x "$MANAGER_REBUILD" ]; then
    write_status running "正在重新构建管理后台" "$START_TS"
    log "开始重建管理后台"
    # --skip-api：统一后端的重启由本助手统一排期（见下面），
    # 控制台重建不要顺手把后端也重启了，免得把本助手自己带走。
    if ! "$MANAGER_REBUILD" --skip-api >> "$LOG" 2>&1; then
      log "管理后台重建失败"
      write_status failed "管理后台构建失败，请查看 $LOG" "$START_TS"
      exit 1
    fi
  else
    log "未找到管理后台重建脚本 $MANAGER_REBUILD，跳过"
  fi
fi

# 后端改了代码就要重启服务（它读的是仓库里的 server/app/，不用重新构建前端）
if [ "$BACKEND_CODE_CHANGED" = "1" ]; then
  write_status running "正在重启统一后端" "$START_TS"
  log "开始重启统一后端"
  # 🌟 用 systemd-run 另起一个瞬态单元来执行重启：
  #    本助手是统一后端 spawn 出来的，和后端在同一条进程链上。
  #    直接 systemctl restart 有可能把助手自己一起停掉，
  #    状态文件就会永远停在「进行中」。交给 systemd 单独跑就没事了。
  if command -v systemd-run >/dev/null 2>&1; then
    if systemd-run --unit=xhblogs-manager-api-restart --on-active=3s --collect \
         /bin/systemctl restart xhblogs-manager-api.service >> "$LOG" 2>&1; then
      log "统一后端重启已排期（3 秒后执行）"
    else
      log "统一后端重启排期失败，改为直接重启"
      $BACKEND_RESTART >> "$LOG" 2>&1 || true
    fi
  else
    $BACKEND_RESTART >> "$LOG" 2>&1 || true
  fi
fi

BUILD_ID=""
if [ -f "$BLOG_DIR/.next/BUILD_ID" ]; then
  BUILD_ID=$(cat "$BLOG_DIR/.next/BUILD_ID" 2>/dev/null)
fi

EFFECTIVE_TS=$(date +%s)

# 结尾文案按 GitHub 推送结果区分：按钮叫「推送到 GitHub」，
# 就得如实说明 GitHub 这一步到底成没成。
case "$GITHUB_STATE" in
  pushed) PUSH_TEXT="已推送到 GitHub 仓库" ;;
  failed) PUSH_TEXT="服务器仓库已同步，但 GitHub 推送失败，请查看 $LOG" ;;
  *)      PUSH_TEXT="已同步服务器仓库（仓库未配置 github 远端）" ;;
esac

if [ "$SITE_CODE_CHANGED" = "1" ]; then
  log "推送完成（已重新构建），构建号 $BUILD_ID；github=$GITHUB_STATE"
  write_status done "$PUSH_TEXT；已重新构建，构建号 ${BUILD_ID:-未知}" "$START_TS" "$EFFECTIVE_TS" "$GITHUB_STATE"
else
  log "推送完成（仅内容改动，无需重新构建，站点已实时生效）；github=$GITHUB_STATE"
  write_status done "$PUSH_TEXT；内容实时生效（本次无需重新构建站点）" "$START_TS" "$EFFECTIVE_TS" "$GITHUB_STATE"
fi
exit 0
