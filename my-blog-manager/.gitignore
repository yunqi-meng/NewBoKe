# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# Machine-local runtime settings (每台机器的端口/路径都不一样，不入库)
/data/deploy_config.json
/public/backend_config.json

# 本机上传的图片 (二进制不入库，发布时镜像到公开站 public/uploads)
/data/uploads/*
!/data/uploads/.gitkeep

# 评论数据库 (访客留言只存在本机，绝不入库)
/data/comments.db
/data/comments.db-wal
/data/comments.db-shm
/data/comments.db-journal

# 每日一句 (内容与设置都是本机生成的运行数据，不入库)
/data/dailyQuote.json
/data/dailyQuoteConfig.json

# 本地音乐 (音频/歌词/封面二进制不入库，只有播放列表元数据入库)
/music/*
!/music/playlist.json

# Local drafts and runtime data
*.connection.json
# Python backend caches
__pycache__/
*.py[cod]
