# 统一后端的运行配置。
#
# ⚠️ 这个文件只是「示例」，真实值请复制成 server/.env 后填写，
#    并确保 .env 已被 .gitignore 忽略（仓库里不保存任何密钥）。

# ---- 数据库 ----
# 默认落在 server/data/blog.db；线上建议指到仓库外，避免重新部署时被清掉。
XHS_DATABASE_URL=sqlite:////var/lib/xhblogs/blog.db

# ---- 目录 ----
# XHS_REPO_ROOT=                 # 仓库根目录，默认自动推断
# XHS_DATA_DIR=                  # 后端数据目录（数据库、上传的音乐等）
# XHS_CONTENT_DIR=               # 媒体目录（uploads / music）
# XHS_SNAPSHOT_DIR=              # 内容快照目录，默认 <仓库根>/snapshots

# ---- 跨域 ----
# XHS_CORS_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:8080

# ---- 鉴权 ----
# 会话签名密钥，必须与控制台共用同一个。openssl rand -base64 32 生成。
MANAGER_SESSION_SECRET=
# 管理员口令哈希，格式 scrypt$N$r$p$salt$hash。留空表示免密（仅限本地开发）。
MANAGER_ADMIN_PASSWORD_HASH=
# Cookie 是否只走 HTTPS（线上公网建议设为 1）
MANAGER_COOKIE_SECURE=0

# ---- AI ----
# 每日一句与煤球用的模型密钥，只从环境变量读。
DEEPSEEK_API_KEY=
